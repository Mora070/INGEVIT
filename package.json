{
  "name": "ingevit-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del sistema de gestión de proyectos de obra",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "db:check": "npm run build && node --env-file=.env dist/scripts/check-database.js",
    "db:test-transactions": "npm run build && node --env-file=.env dist/scripts/check-transactions.js",
    "test": "npm run build && node --test \"test/*.test.cjs\"",
    "test:integration": "npm run build && node --env-file=.env --test \"test/integration/*.test.cjs\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.3",
    "typescript": "5.9"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    }
  }
}
