{
  "name": "ingevit-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del sistema de gestión de proyectos de obra",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "db:check": "npm run build && node --env-file=.env dist/scripts/check-database.js",
    "db:test-transactions": "npm run build && node --env-file=.env dist/scripts/check-transactions.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.3",
    "typescript": "5.9"
  }
}
